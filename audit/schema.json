{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sorabbyngo Audit Log Entry",
  "description": "Hash-chained audit log — Kenya DPA 2019 Section 41",
  "type": "object",
  "required": ["timestamp","event_type","component","node_id","sha256_prev","sha256_self"],
  "properties": {
    "timestamp":    { "type": "string", "format": "date-time" },
    "event_type":   { "type": "string", "enum": ["auth.login","auth.logout","auth.failed","data.access","data.modify","data.delete","data.export","security.threat","security.block","security.escalation","compliance.check","compliance.violation","system.start","system.stop","system.config_change","pki.cert_issued","pki.cert_revoked","secret.rotated","secret.accessed"] },
    "component":    { "type": "string" },
    "node_id":      { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "actor":        { "type": "object", "properties": { "suid": {"type":"string"}, "role": {"type":"string"}, "ip": {"type":"string"} } },
    "resource":     { "type": "object", "properties": { "type": {"type":"string"}, "id": {"type":"string"}, "action": {"type":"string"} } },
    "outcome":      { "type": "string", "enum": ["success","failure","blocked","escalated"] },
    "severity":     { "type": "string", "enum": ["INFO","LOW","MEDIUM","HIGH","CRITICAL"] },
    "metadata":     { "type": "object", "additionalProperties": true },
    "sha256_prev":  { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256_self":  { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
